# Copy this file to .env for local development. Never commit .env.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# ---- PUBLIC (shipped to the browser; safe because RLS protects all data) ----
# Supabase → Project Settings → API (Data API) → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → "Publishable key" (sb_publishable_...)
# The legacy "anon" key also works here.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# ---- PRIVATE (local testing ONLY — never add to Vercel, never use in browser code) ----
# Used only by scripts/test-backend.mjs to create and delete throwaway test accounts.
# Supabase → Project Settings → API Keys → "Secret key" (sb_secret_...) or legacy service_role.
SUPABASE_SECRET_KEY=
# Optional, test-only: a real mailbox for test emails (plus-addressing is used).
TEST_EMAIL_BASE=
